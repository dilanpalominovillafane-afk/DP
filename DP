--==================================================
-- MOVIMIENTO FARM
--==================================================

local function moverConTween(cframe)

    local character = LocalPlayer.Character
    local hrp = character and
        character:FindFirstChild("HumanoidRootPart")

    if not hrp or not farmActivo then
        return
    end

    local distance =
        (hrp.Position-cframe.Position).Magnitude

    local duration =
        math.max(distance/FARM_SPEED,0.05)

    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear
        ),
        {
            CFrame = cframe + Vector3.new(0,1,0)
        }
    )

    tween:Play()

    while tween.PlaybackState == Enum.PlaybackState.Playing do

        if not farmActivo then
            tween:Cancel()
            break
        end

        RunService.Heartbeat:Wait()

    end

end

--==================================================
-- INTERACCIONES FARM
--==================================================

local function interactuar()

    local character = LocalPlayer.Character
    local hrp = character and
        character:FindFirstChild("HumanoidRootPart")

    if not hrp then return end

    for _,prompt in ipairs(Workspace:GetDescendants()) do

        if not farmActivo then
            break
        end

        if prompt:IsA("ProximityPrompt") then

            local parent = prompt.Parent
            local part

            if parent:IsA("BasePart") then
                part = parent

            elseif parent:IsA("Model") then
                part = parent:FindFirstChildWhichIsA("BasePart")
            end

            if part then

                local distance =
                    (hrp.Position-part.Position).Magnitude

                if distance <= 35 then

                    pcall(function()

                        prompt.HoldDuration = 0

                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        end

                    end)

                end

            end

        end

    end

end

--==================================================
-- CICLO FARM
--==================================================

local function cicloFarm()

    if not posA or not posB then
        return
    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: Viajando a A..."

    moverConTween(posA)

    if not farmActivo then return end

    StatusLabel.Text = "Estado: Interactuando..."

    local start = tick()

    while tick()-start < 2.5 and farmActivo do

        interactuar()

        task.wait(.05)

    end

    if not farmActivo then return end

    StatusLabel.Text = "Estado: Entregando en B..."

    moverConTween(posB)

    task.wait(.6)

end

