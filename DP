--==================================================
-- PROXIMITY PROMPTS
--==================================================

local function presionarEnRango()

    local personaje = LocalPlayer.Character
    local hrp = personaje and personaje:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    for _, objeto in pairs(Workspace:GetDescendants()) do

        if not farmActivo then
            break
        end

        if objeto:IsA("ProximityPrompt") then

            local parent = objeto.Parent
            local part = nil

            if parent:IsA("BasePart") then

                part = parent

            elseif parent:IsA("Model") then

                part = parent:FindFirstChildWhichIsA("BasePart")

            end

            if part then

                local distancia =
                    (hrp.Position - part.Position).Magnitude

                if distancia < 35 then

                    pcall(function()
                        fireproximityprompt(objeto, 0)
                    end)

                end

            end

        end

    end

end

--==================================================
-- MOVIMIENTO
--==================================================

local function moverConTween(destinoCFrame)

    local personaje = LocalPlayer.Character
    local hrp = personaje and personaje:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    local distancia =
        (hrp.Position - destinoCFrame.Position).Magnitude

    local duracion =
        distancia / SPEED

    local info = TweenInfo.new(
        duracion,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local goal = {
        CFrame = destinoCFrame + Vector3.new(0, 1, 0)
    }

    local tween =
        TweenService:Create(hrp, info, goal)

    tween:Play()
    tween.Completed:Wait()

end

