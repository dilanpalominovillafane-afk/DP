--==================================================
-- GUARDAR PUNTOS
--==================================================

local function getRoot()

    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

BtnSaveA.MouseButton1Click:Connect(function()

    local root = getRoot()

    if root then
        posA = root.CFrame
        BtnSaveA.Text = "A GUARDADO ✓"
        StatusLabel.Text = "Estado: Punto A guardado."

        task.delay(1.5,function()
            if BtnSaveA.Parent then
                BtnSaveA.Text = "GUARDAR A"
            end
        end)
    end
end)

BtnSaveB.MouseButton1Click:Connect(function()

    local root = getRoot()

    if root then
        posB = root.CFrame
        BtnSaveB.Text = "B GUARDADO ✓"
        StatusLabel.Text = "Estado: Punto B guardado."

        task.delay(1.5,function()
            if BtnSaveB.Parent then
                BtnSaveB.Text = "GUARDAR B"
            end
        end)
    end
end)

--==================================================
-- TELEPORT
--==================================================

local function teleportTo(cframe)

    local root = getRoot()

    if root and cframe then
        root.CFrame = cframe + Vector3.new(0,2,0)
        return true
    end

    return false
end

BtnTeleportA.MouseButton1Click:Connect(function()

    if teleportTo(posA) then
        StatusLabel.Text = "Estado: Teleport → A ✓"
    else
        StatusLabel.Text = "Estado: primero guarda A."
    end

end)

BtnTeleportB.MouseButton1Click:Connect(function()

    if teleportTo(posB) then
        StatusLabel.Text = "Estado: Teleport → B ✓"
    else
        StatusLabel.Text = "Estado: primero guarda B."
    end

end)

