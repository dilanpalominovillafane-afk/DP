--==================================================

local function createSection(text, y)

    local label = Instance.new("TextLabel")
    label.Parent = Content
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 2, 0, y)
    label.Size = UDim2.new(1, -4, 0, 22)
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(175, 175, 185)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    return label
end

local function createButton(text, position, size)

    local button = Instance.new("TextButton")
    button.Parent = Content
    button.Position = position
    button.Size = size
    button.BackgroundColor3 = Color3.fromRGB(42, 42, 51)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.GothamMedium
    button.Text = text
    button.TextColor3 = Color3.fromRGB(235, 235, 240)
    button.TextSize = 12
    button.AutoButtonColor = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(65, 65, 76)
    stroke.Thickness = 1
    stroke.Transparency = 0
    stroke.Parent = button

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = Color3.fromRGB(52, 52, 63)
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = Color3.fromRGB(42, 42, 51)
    end)

    return button
end

