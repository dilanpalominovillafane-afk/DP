local function section(text, y)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,-10,0,25)
    label.Position = UDim2.new(0,5,0,y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(190,190,200)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = Content

    return label
end

local function button(text,x,y,w,h)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0,w,0,h)
    b.Position = UDim2.new(0,x,0,y)
    b.BackgroundColor3 = Color3.fromRGB(35,35,43)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.fromRGB(235,235,240)
    b.TextSize = 12
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = true
    b.Parent = Content

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,8)
    c.Parent = b

    return b
end

local function inputBox(text,x,y,w)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0,w,0,32)
    box.Position = UDim2.new(0,x,0,y)
    box.BackgroundColor3 = Color3.fromRGB(30,30,37)
    box.BorderSizePixel = 0
    box.Text = text
    box.TextColor3 = Color3.fromRGB(255,255,255)
    box.PlaceholderColor3 = Color3.fromRGB(120,120,130)
    box.TextSize = 12
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = Content

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,7)
    c.Parent = box

    return box
end

local function setState(buttonObj, enabled, onText, offText)
    if enabled then
        buttonObj.Text = onText
        buttonObj.BackgroundColor3 = Color3.fromRGB(45,90,65)
    else
        buttonObj.Text = offText
        buttonObj.BackgroundColor3 = Color3.fromRGB(35,35,43)
    end
end

local function root()
    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

