local function teleportTo(cframe)

	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root and cframe then

		root.CFrame = cframe + Vector3.new(0,2,0)

		return true

	end

	return false
end

