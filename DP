local function moverA(cframe)

	if not root then
		return
	end

	local distancia = (root.Position - cframe.Position).Magnitude

	local tiempo = math.max(
		distancia / math.max(FARM_SPEED, 1),
		0.05
	)

	local tween = TweenService:Create(
		root,
		TweenInfo.new(
			tiempo,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = cframe
		}
	)

	tween:Play()
	tween.Completed:Wait()

end

local function interactuarConPrompts()

	for _, obj in ipairs(Workspace:GetDescendants()) do

		if not farmActivo then
			return
		end

		if obj:IsA("ProximityPrompt") then

			pcall(function()

				obj:InputHoldBegin()

				task.wait(
					math.max(
						obj.HoldDuration,
						0
					)
				)

				obj:InputHoldEnd()

			end)
		end
	end
end

task.spawn(function()

	while true do

		if farmActivo then

			if not posA or not posB then

				status("Guarda A y B primero")

				farmActivo = false

				BtnFarm.Text = "AUTO-FARM    ● OFF"

			else

				status("Auto-Farm: yendo a A")

				moverA(posA)

				if farmActivo then
					interactuarConPrompts()
				end

				if farmActivo then

					status("Auto-Farm: yendo a B")

					moverA(posB)

					if farmActivo then
						interactuarConPrompts()
					end

				end
			end

		else

			task.wait(0.1)

		end

		task.wait(0.05)

	end
end)

BtnFarm.MouseButton1Click:Connect(function()

	farmActivo = not farmActivo

	if farmActivo then

		if not posA or not posB then

			farmActivo = false

			status("Guarda A y B primero")

			return
		end

		BtnFarm.Text = "AUTO-FARM    ● ON"

		status("Auto-Farm activado")

	else

		BtnFarm.Text = "AUTO-FARM    ● OFF"

		status("Auto-Farm detenido")

	end
end)

