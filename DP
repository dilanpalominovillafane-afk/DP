local function createSection(text,y)

    local label = Instance.new("TextLabel")
    label.Parent = Content
    label.Position = UDim2.new(0,2,0,y)
    label.Size = UDim2.new(1,-4,0,22)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(175,175,185)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    return label
end

local function createButton(text,pos,size)

    local b = Instance.new("TextButton")
    b.Parent = Content
    b.Position = pos
    b.Size = size
    b.BackgroundColor3 = Color3.fromRGB(42,42,51)
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamMedium
    b.Text = text
    b.TextColor3 = Color3.fromRGB(235,235,240)
    b.TextSize = 12
    b.AutoButtonColor = false

    Instance.new("UICorner",b).CornerRadius = UDim.new(0,8)

    local s = Instance.new("UIStroke")
    s.Parent = b
    s.Color = Color3.fromRGB(65,65,76)
    s.Thickness = 1

    b.MouseEnter:Connect(function()
        if b:GetAttribute("Locked") ~= true then
            b.BackgroundColor3 = Color3.fromRGB(52,52,63)
        end
    end)

    b.MouseLeave:Connect(function()
        if b:GetAttribute("Locked") ~= true then
            b.BackgroundColor3 = Color3.fromRGB(42,42,51)
        end
    end)

    return b
end

local function lockButton(b)

    b:SetAttribute("Locked",true)
    b.BackgroundColor3 = Color3.fromRGB(32,32,38)
    b.TextColor3 = Color3.fromRGB(100,100,108)

    local s = b:FindFirstChildOfClass("UIStroke")
    if s then
        s.Color = Color3.fromRGB(45,45,52)
    end
end

