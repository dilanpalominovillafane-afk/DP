local function button(text,pos,size)

	local b = Instance.new("TextButton")
	b.Position = pos
	b.Size = size
	b.BackgroundColor3 = Color3.fromRGB(42,42,51)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamMedium
	b.Text = text
	b.TextColor3 = Color3.fromRGB(235,235,240)
	b.TextSize = 12
	b.AutoButtonColor = false
	b.Parent = content

	Instance.new("UICorner",b).CornerRadius = UDim.new(0,7)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(65,65,76)
	stroke.Transparency = .3
	stroke.Parent = b

	b.MouseEnter:Connect(function()
		if not b:GetAttribute("active") then
			b.BackgroundColor3 = Color3.fromRGB(52,52,63)
		end
	end)

	b.MouseLeave:Connect(function()
		if not b:GetAttribute("active") then
			b.BackgroundColor3 = Color3.fromRGB(42,42,51)
		end
	end)

	return b
end

local function state(b,on,onText,offText)

	b:SetAttribute("active",on)

	if on then
		b.Text = onText
		b.BackgroundColor3 = Color3.fromRGB(45,135,75)
	else
		b.Text = offText
		b.BackgroundColor3 = Color3.fromRGB(42,42,51)
	end
end

