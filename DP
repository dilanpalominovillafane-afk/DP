local function applyInstantInteraction()

	for _,obj in ipairs(game:GetDescendants()) do

		if obj:IsA("ProximityPrompt") then
			obj.HoldDuration = 0
		end

	end
end

local function watchInstantInteraction()

	if not instantInteraction then
		return
	end

	applyInstantInteraction()
end

BtnInstant.MouseButton1Click:Connect(function()

	instantInteraction = not instantInteraction

	setButtonState(
		BtnInstant,
		instantInteraction,
		"INTERACCIÓN INSTANTÁNEA    ● ON",
		"INTERACCIÓN INSTANTÁNEA    ● OFF"
	)

	if instantInteraction then

		applyInstantInteraction()

		StatusLabel.Text =
			"Estado: Interacción instantánea activa."

	else

		StatusLabel.Text =
			"Estado: Interacción instantánea desactivada."

	end

end)

game.DescendantAdded:Connect(function(obj)

	if instantInteraction and obj:IsA("ProximityPrompt") then
		obj.HoldDuration = 0
	end

end)

