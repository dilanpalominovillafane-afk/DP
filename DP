local function toggleFarm()

    farmActivo = not farmActivo

    if farmActivo then

        BtnFarm.Text = "AUTO-FARM    ● ON"
        BtnFarm.BackgroundColor3 =
            Color3.fromRGB(45,135,75)

        StatusLabel.Text =
            "Estado: Auto-Farm activo."

        task.spawn(function()

            while farmActivo do

