-- PROXIMITY
--==================================================

local function presionarEnRango()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp then return end

    for _,obj in ipairs(Workspace:GetDescendants()) do

        if not farmActivo then
            break
        end

        if obj:IsA("ProximityPrompt") then

            local parent = obj.Parent
            local part

            if parent:IsA("BasePart") then
                part = parent
            elseif parent:IsA("Model") then
                part = parent:FindFirstChildWhichIsA("BasePart")
            end

            if part then

                local distance =
                    (hrp.Position - part.Position).Magnitude

                if distance <= 35 then

                    pcall(function()
                        fireproximityprompt(obj,0)
                    end)

                end

            end

        end

    end

end

--==================================================
-- MOVIMIENTO FARM
--==================================================

local function moverConTween(destino)

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp or not destino then
        return false
    end

    local distancia =
        (hrp.Position - destino.Position).Magnitude

    local duracion =
        math.max(distancia / math.max(SPEED,1),0.05)

    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(
            duracion,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = destino + Vector3.new(0,1,0)
        }
    )

    tween:Play()

    while tween.PlaybackState == Enum.PlaybackState.Playing do

        if not farmActivo then
            tween:Cancel()
            return false
        end

        task.wait()

    end

    return true
end

--==================================================
-- AUTO FARM
--==================================================

local function cicloFarm()

    if not posA or not posB then
        return
    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: Viajando a A..."
    if not moverConTween(posA) then return end

    if not farmActivo then return end

    StatusLabel.Text = "Estado: Recogiendo..."

    local inicio = tick()

    while farmActivo and tick()-inicio < 2.5 do
        pcall(presionarEnRango)
        task.wait(.05)
    end

    if not farmActivo then return end

    StatusLabel.Text = "Estado: Entregando en B..."
    if not moverConTween(posB) then return end

    task.wait(.6)
end

local function cambiarFarm()

    farmActivo = not farmActivo

    if farmActivo then

        if not posA or not posB then
            farmActivo = false
            StatusLabel.Text = "Estado: Primero guarda A y B."
            return
        end

        BtnToggleFarm.Text = "AUTO-FARM    ● ON"
        BtnToggleFarm.BackgroundColor3 = Color3.fromRGB(45,135,75)

        StatusLabel.Text = "Estado: Auto-Farm activo."

        task.spawn(function()

            while farmActivo do
                pcall(cicloFarm)
                task.wait(.1)
            end

        end)

    else

        BtnToggleFarm.Text = "AUTO-FARM    ● OFF"
        BtnToggleFarm.BackgroundColor3 = Color3.fromRGB(42,42,51)

        StatusLabel.Text = "Estado: Farm detenido."

    end

end

BtnToggleFarm.MouseButton1Click:Connect(cambiarFarm)

