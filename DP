--==================================================
-- AUTO CLICKER 160 CPS
-- CENTRO DE PANTALLA
--==================================================

local acumulado = 0

local function hacerClickCentro()

    local camera = Workspace.CurrentCamera

    if not camera then return end

    local viewport = camera.ViewportSize

    local x = viewport.X / 2
    local y = viewport.Y / 2

    pcall(function()

        if mouse1click then
            mouse1click()
            return
        end

        if VirtualInputManager then

            VirtualInputManager:SendMouseButtonEvent(
                x,
                y,
                0,
                true,
                game,
                0
            )

            VirtualInputManager:SendMouseButtonEvent(
                x,
                y,
                0,
                false,
                game,
                0
            )

        end

    end)

end

BtnAutoClick.MouseButton1Click:Connect(function()

    autoClickActivo = not autoClickActivo
    acumulado = 0

    if autoClickActivo then

        BtnAutoClick.Text =
            "AUTO CLICKER    ● ON • 160 CPS"

        BtnAutoClick.BackgroundColor3 =
            Color3.fromRGB(45,135,75)

        StatusLabel.Text =
            "Estado: Auto Clicker 160 CPS activo."

    else

        BtnAutoClick.Text =
            "AUTO CLICKER    ● OFF"

        BtnAutoClick.BackgroundColor3 =
            Color3.fromRGB(42,42,51)

        StatusLabel.Text =
            "Estado: Auto Clicker detenido."

    end

end)

RunService.RenderStepped:Connect(function(deltaTime)

    if not autoClickActivo then
        return
    end

    acumulado += deltaTime

    while acumulado >= CLICK_INTERVAL do

        acumulado -= CLICK_INTERVAL

        hacerClickCentro()

    end

end)

