--==================================================
-- MOVER
--==================================================

local function moveTo(cframe)

	local r = root()

	if not r or not cframe then
		return false
	end

	local distance =
		(r.Position - cframe.Position).Magnitude

	local duration =
		math.max(distance / math.max(FARM_SPEED,1),0.05)

	local tween = TweenService:Create(
		r,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = cframe + Vector3.new(0,2,0)
		}
	)

	tween:Play()

	while tween.PlaybackState == Enum.PlaybackState.Playing do

		if not farmRunning then
			tween:Cancel()
			return false
		end

		task.wait()
	end

	return true
end

--==================================================
-- INTERACTUAR CON PROMPTS
--==================================================

local function interactNearby()

	local r = root()

	if not r then
		return
	end

	for _,prompt in ipairs(workspace:GetDescendants()) do

		if not farmRunning then
			return
		end

		if prompt:IsA("ProximityPrompt")
			and prompt.Enabled then

			local parent = prompt.Parent

			if parent and parent:IsA("BasePart") then

				local distance =
					(r.Position - parent.Position).Magnitude

				if distance <= prompt.MaxActivationDistance then

					if instantInteraction then
						prompt.HoldDuration = 0
					end

					-- Interacción válida desde el cliente
					prompt:InputHoldBegin()

					task.wait(
						math.max(prompt.HoldDuration,0)
					)

					prompt:InputHoldEnd()

					task.wait(.05)
				end
			end
		end
	end
end

--==================================================
-- CICLO AUTO-FARM
--==================================================

local function farmCycle()

	if not posA or not posB then
		status.Text =
			"Estado: primero guarda A y B."
		return
	end

	status.Text =
		"Estado: → Punto A"

	if not moveTo(posA) then
		return
	end

	if not farmRunning then
		return
	end

	status.Text =
		"Estado: interactuando..."

	local start = os.clock()

	while farmRunning and os.clock() - start < 2.5 do

		interactNearby()

		task.wait(.05)
	end

	if not farmRunning then
		return
	end

	status.Text =
		"Estado: → Punto B"

	if not moveTo(posB) then
		return
	end

	task.wait(.6)
end

