local function hacerClick()

    local camera = Workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local x = viewport.X / 2
    local y = viewport.Y / 2

    -- Método 1
    pcall(function()

        VirtualInputManager:SendMouseButtonEvent(
            x,y,0,true,game,0
        )

        VirtualInputManager:SendMouseButtonEvent(
            x,y,0,false,game,0
        )

    end)

    -- Método alternativo de executor
    if typeof(mouse1click) == "function" then
        pcall(mouse1click)
    end

end

BtnAutoClick.MouseButton1Click:Connect(function()

    autoClickActivo = not autoClickActivo

    if autoClickActivo then

        BtnAutoClick.Text = "AUTO CLICKER    ● ON"
        BtnAutoClick.BackgroundColor3 = Color3.fromRGB(45,135,75)

        StatusLabel.Text = "Estado: Auto Clicker 160 CPS"

        task.spawn(function()

            while autoClickActivo do

                hacerClick()

                task.wait(CLICK_INTERVAL)

            end

        end)

    else

        BtnAutoClick.Text = "AUTO CLICKER    ● OFF"
        BtnAutoClick.BackgroundColor3 = Color3.fromRGB(42,42,51)

        StatusLabel.Text = "Estado: Auto Clicker detenido."

    end

end)

--==================================================
-- PROXIMITY PROMPTS
--==================================================

local function presionarEnRango()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    for _,prompt in ipairs(Workspace:GetDescendants()) do

        if not farmActivo then
            break
        end

        if prompt:IsA("ProximityPrompt") then

            local parent = prompt.Parent
            local part

            if parent:IsA("BasePart") then
                part = parent
            elseif parent:IsA("Model") then
                part = parent:FindFirstChildWhichIsA("BasePart")
            end

            if part then

                local distancia =
                    (hrp.Position - part.Position).Magnitude

                if distancia <= 35 then

                    pcall(function()
                        prompt:InputHoldBegin()
                        prompt:InputHoldEnd()
                    end)

                    pcall(function()
                        fireproximityprompt(prompt,0)
                    end)

                end

            end

        end

    end

end

--==================================================
-- MOVIMIENTO
--==================================================

local function moverConTween(destino)

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not hrp or not destino then
        return false
    end

    local distancia =
        (hrp.Position - destino.Position).Magnitude

    local duracion = math.max(distancia / FARM_SPEED,0.05)

    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(
            duracion,
            Enum.EasingStyle.Linear
        ),
        {
            CFrame = destino + Vector3.new(0,1,0)
        }
    )

    tween:Play()

    local terminado = false

    tween.Completed:Connect(function()
        terminado = true
    end)

    while not terminado and farmActivo do
        task.wait()
    end

    if not farmActivo then
        tween:Cancel()
        return false
    end

    return true
end

--==================================================
-- CICLO FARM
--==================================================

local function cicloFarm()

    if not posA or not posB then
        StatusLabel.Text = "Estado: guarda A y B primero."
        return
    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: viajando a A..."

    if not moverConTween(posA) then
        return
    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: recogiendo..."

    local inicio = tick()

    while farmActivo and tick() - inicio < 2.5 do

        presionarEnRango()

        task.wait(.05)

    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: entregando en B..."

    moverConTween(posB)

    if farmActivo then
        task.wait(.6)
    end

end

--==================================================
-- AUTO FARM
--==================================================

local function cambiarFarm()

    farmActivo = not farmActivo

    if farmActivo then

        MainFrame:SetAttribute("FarmActivo",true)

        BtnToggleFarm.Text = "AUTO-FARM    ● ON"
        BtnToggleFarm.BackgroundColor3 = Color3.fromRGB(45,135,75)

        StatusLabel.Text = "Estado: Auto-Farm activo."

        task.spawn(function()

            while farmActivo do

                local ok,err = pcall(cicloFarm)

                if not ok then
                    StatusLabel.Text = "Estado: error del farm"
                    task.wait(.5)
                end

                task.wait(.1)

            end

        end)

    else

        MainFrame:SetAttribute("FarmActivo",false)

        BtnToggleFarm.Text = "AUTO-FARM    ● OFF"
        BtnToggleFarm.BackgroundColor3 = Color3.fromRGB(42,42,51)

        StatusLabel.Text = "Estado: Farm detenido."

    end

end

BtnToggleFarm.MouseButton1Click:Connect(function()

    if not posA or not posB then
        StatusLabel.Text = "Estado: primero guarda A y B."
        return
    end

    cambiarFarm()

end)

