--==================================================
-- PROXIMITY
--==================================================

local function presionarEnRango()

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return
    end

    for _,prompt in ipairs(Workspace:GetDescendants()) do

        if not farmActivo then
            break
        end

        if prompt:IsA("ProximityPrompt") then

            local parent = prompt.Parent
            local part

            if parent and parent:IsA("BasePart") then

                part = parent

            elseif parent and parent:IsA("Model") then

                part = parent:FindFirstChildWhichIsA("BasePart",true)

            end

            if part then

                local distance =
                    (hrp.Position - part.Position).Magnitude

                if distance <= 35 then

                    pcall(function()
                        prompt.HoldDuration = 0
                        fireproximityprompt(prompt,0)
                    end)

                end

            end

        end

    end

end

--==================================================
-- MOVIMIENTO
--==================================================

local function moverConTween(destino)

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp or not destino then
        return false
    end

    local distance =
        (hrp.Position - destino.Position).Magnitude

    if distance < 3 then
        return true
    end

    local duration = math.max(distance / SPEED,0.05)

    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = destino + Vector3.new(0,1,0)
        }
    )

    tween:Play()

    local completed = false

    local connection
    connection = tween.Completed:Connect(function()
        completed = true
    end)

    while not completed and farmActivo do
        task.wait()
    end

    connection:Disconnect()

    return completed
end

--==================================================
-- AUTO FARM
--==================================================

local function cicloFarm()

    if not farmActivo or not posA or not posB then
        return
    end

    StatusLabel.Text = "Estado: viajando a A..."

    moverConTween(posA)

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: recogiendo..."

    local inicio = os.clock()

    while farmActivo and os.clock() - inicio < 2.5 do

        presionarEnRango()

        task.wait(0.05)

    end

    if not farmActivo then
        return
    end

    StatusLabel.Text = "Estado: entregando en B..."

    moverConTween(posB)

    task.wait(0.5)

end

local function cambiarFarm()

    farmActivo = not farmActivo

    if farmActivo then

        if not posA or not posB then

            farmActivo = false
            StatusLabel.Text = "Estado: primero guarda A y B"
            return

        end

        BtnToggleFarm.Text =
            "AUTO-FARM    ● ON"

        BtnToggleFarm.BackgroundColor3 =
            Color3.fromRGB(45,135,75)

        StatusLabel.Text =
            "Estado: Auto-Farm activo"

        task.spawn(function()

            while farmActivo do

                pcall(cicloFarm)

                task.wait(0.05)

            end

        end)

    else

        BtnToggleFarm.Text =
            "AUTO-FARM    ● OFF"

        BtnToggleFarm.BackgroundColor3 =
            Color3.fromRGB(42,42,51)

        StatusLabel.Text =
            "Estado: Auto-Farm detenido"

    end

end

BtnToggleFarm.MouseButton1Click:Connect(cambiarFarm)

--==================================================
-- AUTO CLICKER 160 CPS
-- CENTRO DE LA PANTALLA
--==================================================

BtnAutoClick.MouseButton1Click:Connect(function()

    autoClickActivo = not autoClickActivo

    if autoClickActivo then

        BtnAutoClick.Text =
            "AUTO CLICKER    ● ON"

        BtnAutoClick.BackgroundColor3 =
            Color3.fromRGB(45,135,75)

        StatusLabel.Text =
            "Estado: Auto Clicker 160 CPS"

        task.spawn(function()

            local acumulado = 0

            while autoClickActivo do

                local dt = RunService.Heartbeat:Wait()
                acumulado += dt

                while acumulado >= CLICK_INTERVAL do

                    acumulado -= CLICK_INTERVAL

                    local camera = Workspace.CurrentCamera

                    if camera then

                        local viewport = camera.ViewportSize

                        local centerX = viewport.X / 2
                        local centerY = viewport.Y / 2

                        pcall(function()

                            VirtualInputManager:SendMouseButtonEvent(
                                centerX,
                                centerY,
                                0,
                                true,
                                game,
                                0
                            )

                            VirtualInputManager:SendMouseButtonEvent(
                                centerX,
                                centerY,
                                0,
                                false,
                                game,
                                0
                            )

                        end)

                    end

                end

            end

        end)

    else

        BtnAutoClick.Text =
            "AUTO CLICKER    ● OFF"

        BtnAutoClick.BackgroundColor3 =
            Color3.fromRGB(42,42,51)

        StatusLabel.Text =
            "Estado: Auto Clicker detenido"

    end

end)

