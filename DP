local function moveTo(cframe)

    local r = root()

    if not r or not cframe then
        return false
    end

    local distance = (r.Position - cframe.Position).Magnitude

    local duration = math.max(
        distance / math.max(FARM_SPEED,1),
        0.05
    )

    local tween = TweenService:Create(
        r,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear
        ),
        {
            CFrame = cframe
        }
    )

    tween:Play()
    tween.Completed:Wait()

    return true
end

local function interactNearby()

    local r = root()

    if not r then
        return
    end

    for _,obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("ProximityPrompt")
        and obj.Enabled then

            local parent = obj.Parent

            if parent and parent:IsA("BasePart") then

                local distance =
                    (r.Position - parent.Position).Magnitude

                if distance <= obj.MaxActivationDistance then

                    if instantInteraction then
                        obj.HoldDuration = 0
                    end

                    obj:InputHoldBegin()

                    task.wait(obj.HoldDuration)

                    obj:InputHoldEnd()

                end
            end
        end
    end
end

local function farmCycle()

    if not posA or not posB then

        Status.Text =
            "Estado: Guarda Punto A y Punto B primero."

        return
    end

    moveTo(posA)

    task.wait(0.2)

    interactNearby()

    task.wait(2.5)

    moveTo(posB)

    task.wait(0.6)
end

AutoFarm.MouseButton1Click:Connect(function()

    farmRunning = not farmRunning

    setState(
        AutoFarm,
        farmRunning,
        "AUTO-FARM    ● ON",
        "AUTO-FARM    ● OFF"
    )

    if farmRunning then

        if not posA or not posB then

            farmRunning = false

            setState(
                AutoFarm,
                false,
                "AUTO-FARM    ● ON",
                "AUTO-FARM    ● OFF"
            )

            Status.Text =
                "Estado: Guarda A y B antes de iniciar."

            return
        end

        Status.Text = "Estado: Auto-Farm activo."

        task.spawn(function()

            while farmRunning do

                farmCycle()

                task.wait(0.1)

            end

        end)

    else

        Status.Text = "Estado: Auto-Farm detenido."

    end
end)

