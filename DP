                        local viewport =
                            camera.ViewportSize

                        local x =
                            viewport.X / 2

                        local y =
                            viewport.Y / 2

                        VirtualInputManager:SendMouseButtonEvent(
                            x,
                            y,
                            0,
                            true,
                            game,
                            0
                        )

                        VirtualInputManager:SendMouseButtonEvent(
                            x,
                            y,
                            0,
                            false,
                            game,
                            0
                        )

                    end

                end)

                task.wait(CLICK_INTERVAL)

            end

        end)

    else

        BtnAutoClick.Text =
            "AUTO CLICKER    ● OFF"

        BtnAutoClick.BackgroundColor3 =
            Color3.fromRGB(42, 42, 51)

        StatusLabel.Text =
            "Estado: Auto Clicker detenido."

    end

end)

--==================================================
-- CICLO FARM
--==================================================

local function cicloFarm()

    if not posA or not posB then
        return
    end

    if not farmActivo then
        return
    end

    StatusLabel.Text =
        "Estado: Viajando al Punto A..."

    moverConTween(posA)

    if farmActivo then

        StatusLabel.Text =
            "Estado: Agarrando objetos..."

        local tiempoInicio = tick()

        while tick() - tiempoInicio < 2.5
            and farmActivo do

            pcall(presionarEnRango)

            task.wait(0.05)

        end

    end

    if farmActivo then

        StatusLabel.Text =
            "Estado: Entregando en Punto B..."

        moverConTween(posB)

        task.wait(0.6)

    end

end

